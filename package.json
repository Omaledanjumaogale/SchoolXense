{
  "name": "schoolxense",
  "version": "1.0.0",
  "description": "SchoolXense — the unified learn-and-earn hub (Hive Secondary, Campus, Pro, Tutors, Cohorts, Library, Studio, Collab, Skills, Institutions, Ambassadors, Record).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name schoolxense",
    "check:backend": "tsc -p convex/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "convex-test": "^0.0.60",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.1",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/rate-limiter": "^0.4.0",
    "@convex-dev/workflow": "^0.4.8",
    "@convex-dev/workpool": "^0.4.13",
    "@fontsource-variable/albert-sans": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@mmailaender/convex-better-auth-svelte": "^0.9.0",
    "better-auth": "~1.6.15",
    "convex": "^1.27.0",
    "convex-helpers": "^0.1.100",
    "convex-svelte": "^0.14.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  }
}
