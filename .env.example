# ── Private (Workers secrets in production) ────────────────────
FLW_CLIENT_ID=                # Flutterwave v4 OAuth client ID
FLW_SECRET_KEY=               # Flutterwave v4 client secret, not a v3 FLWSECK key
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=              # the "Secret hash" set in Flutterwave dashboard → Webhooks
FLW_ENABLED=false
KORAPAY_SECRET_KEY=
KORAPAY_ENCRYPTION_KEY=
KORAPAY_ENABLED=false
PAYOUT_PROVIDER=korapay
BANK_ENCRYPTION_KEY=          # dedicated 32-byte hex key; Convex only; retain for recovery
WEB_PUSH_PUBLIC_KEY=          # VAPID public key; returned to authenticated subscribers
WEB_PUSH_PRIVATE_KEY=         # VAPID private key; Convex only
AGNES_AI_KEY=
AGNES_AI_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_AI_MODEL=agnes-3.0-flash
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
BETTER_AUTH_SECRET=
INTERNAL_WEBHOOK_TOKEN=
MEDIA_SIGNING_SECRET=
NIN_ENCRYPTION_KEY=           # 32 random bytes encoded as 64 hex characters; Convex only
EWIN_SYNC_SECRET=             # shared server-only HMAC key; same value in E-WIN
EWIN_SYNC_ENDPOINT=https://affable-dragon-883.eu-west-1.convex.site/schoolxense/events
EWIN_SYNC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
